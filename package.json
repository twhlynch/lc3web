{
	"name": "lc3web",
	"version": "1.0.0",
	"description": "Web-based simulator for the LC-3 teaching computer.",
	"type": "module",
	"private": true,
	"packageManager": "pnpm@12.9.0",
	"engines": {
		"node": ">=v24.18.0"
	},
	"scripts": {
		"dev": "pnpm --filter @lc3/web dev",
		"preview": "pnpm --filter @lc3/web preview",
		"build": "pnpm -r --if-present build",
		"lint": "eslint .",
		"lint:fix": "eslint --fix .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"check": "tsc --noEmit && pnpm -r --if-present check",
		"bot:types": "pnpm --filter @lc3/bot types",
		"bot:register": "pnpm --filter @lc3/bot register",
		"bot:dev": "pnpm --filter @lc3/bot dev",
		"bot:deploy": "pnpm --filter @lc3/bot deploy",
		"cli": "pnpm --filter @lc3/cli start"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@ianvs/prettier-plugin-sort-imports": "^4.7.1",
		"@types/node": "^25.9.2",
		"eslint": "^10.5.0",
		"jiti": "^2.7.0",
		"prettier": "^3.5.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.61.0"
	}
}
