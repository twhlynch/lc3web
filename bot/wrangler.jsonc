{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "lc3web-bot",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true,
	},
	"placement": {
		"mode": "smart",
	},
	"secrets": {
		"required": ["DISCORD_APPLICATION_ID", "DISCORD_TOKEN", "PUBLIC_KEY"],
	},
}
